# Copy to .env. Demo mode works with only DATABASE_URL and SESSION_SECRET.

DATABASE_URL=postgresql://sera:sera@localhost:5432/sera
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-chars
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3847
DEMO_MODE=true
PAYMENT_PROVIDER=stub

# Telegram. Leave blank to use the web demo without a bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHANNELS=ethiojobsofficial

# Optional model. With no key, matching stays deterministic.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Protects POST /api/cron
CRON_SECRET=replace-with-another-long-random-string

# Set PAYMENT_PROVIDER=chapa and add the secret before any live charge.
# CHAPA_SECRET_KEY=
# TELEBIRR_FABRIC_APP_ID=
# TELEBIRR_APP_SECRET=
# TELEBIRR_SHORT_CODE=

WORKER_INTERVAL_MS=900000
DIGEST_UTC_HOUR=5
